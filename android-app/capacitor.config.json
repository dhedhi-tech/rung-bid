{
  "appId": "com.dhedhitech.pattaparty",
  "appName": "Patta Party",
  "webDir": "www",
  "server": {
    "url": "https://www.pattaparty.com",
    "androidScheme": "https",
    "allowNavigation": [
      "pattaparty.com",
      "www.pattaparty.com"
    ]
  },
  "appendUserAgent": "PattaPartyApp",
  "android": {
    "backgroundColor": "#0c1618"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#0c1618",
      "showSpinner": false
    }
  }
}
